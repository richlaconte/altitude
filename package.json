{
  "name": "altitude-design",
  "version": "0.2.1",
  "description": "A design and HCI framework for agent-built React web applications, where height is the interface.",
  "keywords": [
    "react",
    "design-system",
    "components",
    "elevation",
    "ui",
    "hci",
    "workflow",
    "agents"
  ],
  "license": "MIT",
  "homepage": "https://richlaconte.github.io/altitude/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/richlaconte/altitude.git"
  },
  "bugs": {
    "url": "https://github.com/richlaconte/altitude/issues/new/choose"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types-cjs/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./chart-themes": {
      "import": {
        "types": "./dist/types/chart-themes.d.ts",
        "default": "./dist/chart-themes.js"
      },
      "require": {
        "types": "./dist/types-cjs/chart-themes.d.cts",
        "default": "./dist/chart-themes.cjs"
      }
    },
    "./altitude.css": "./dist/altitude.css",
    "./altitude.no-fonts.css": "./dist/altitude.no-fonts.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.css": "./dist/tokens.css",
    "./tokens.json": "./dist/tokens.json",
    "./altitude.iife.js": "./dist/altitude.iife.js",
    "./package.json": "./package.json",
    "./guidance": "./dist/guidance/index.json",
    "./guidance/*": "./dist/guidance/*"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "scripts": {
    "build": "node scripts/build-package.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit --declaration false --emitDeclarationOnly false",
    "storybook": "node scripts/stories.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/stories.mjs && storybook build -o storybook-static --quiet",
    "build-site": "node scripts/build-site.mjs",
    "check:guidance": "node build/checks/guidance.mjs",
    "check:agent-setup": "node build/checks/agent-setup.mjs",
    "check:framework": "node scripts/check-framework.mjs"
  },
  "devDependencies": {
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "esbuild": "0.28.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "typescript": "5.6.3",
    "vite": "8.3.3"
  },
  "bin": {
    "altitude": "./dist/cli/altitude.mjs"
  }
}
